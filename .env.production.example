# Railway / production — copy into host Environment Variables (not committed).
# Same keys as env.example; use live Razorpay keys when you go live.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Railway: reference Redis plugin URL, or set REDIS_HOST / REDIS_PORT / REDIS_PASSWORD
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
API_KEY_ENCRYPTION_SECRET=

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Webhook URL in Razorpay dashboard: https://YOUR-RAILWAY-URL/api/payment/webhook

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must include your Vercel app origin(s)
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000
