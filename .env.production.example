# Railway / production — copy into host Environment Variables (not committed).
# Same keys as env.example; use live Razorpay keys when you go live.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Railway: reference Redis plugin URL, or set REDIS_HOST / REDIS_PORT / REDIS_PASSWORD
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Required for /api-keys/regenerate + encrypted key storage (stable across deploys, or decryption breaks)
API_KEY_ENCRYPTION_SECRET=

# Razorpay — https://dashboard.razorpay.com/app/keys (Test mode OFF for live settlements)
# Use rzp_live_* + webhook created under the same live account. Re-run razorpay:link-plans with LIVE plan_* IDs on this DB.
# Optional sanity check: RAZORPAY_MODE=live (must match key prefix)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_MODE=live

# Webhook URL in Razorpay dashboard (live): https://YOUR-RAILWAY-URL/api/payment/webhook

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must include your Vercel app origin(s)
CORS_ORIGIN=https://www.datacaptain.in,https://datacaptain.in,http://localhost:3000
