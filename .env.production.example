# Railway / production — copy into host Environment Variables (not committed).
# Same keys as env.example; use live Razorpay keys when you go live.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Railway: reference Redis plugin URL, or set REDIS_HOST / REDIS_PORT / REDIS_PASSWORD
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Required for /api-keys/regenerate + encrypted key storage (stable across deploys, or decryption breaks)
API_KEY_ENCRYPTION_SECRET=

# Razorpay — https://dashboard.razorpay.com/app/keys (Test mode OFF for live settlements)
# Use rzp_live_* + webhook created under the same live account. Re-run razorpay:link-plans with LIVE plan_* IDs on this DB.
# Optional sanity check: RAZORPAY_MODE=live (must match key prefix)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_MODE=live

# Razorpay Dashboard → Webhooks (live): https://api.datacaptain.in/v1/payment/webhook
PUBLIC_API_URL=https://api.datacaptain.in

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Marketing email (SMTP). Example Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=resend SMTP_PASS=re_xxx
# Verify datacaptain.in (SPF + DKIM + DMARC) with your provider before sending campaigns.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=DataCaptain <hello@datacaptain.in>
EMAIL_REPLY_TO=
APP_PUBLIC_URL=https://www.datacaptain.in
# Signs unsubscribe links — keep stable across deploys (defaults to JWT_ACCESS_SECRET)
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_SEND_DELAY_MS=250
EMAIL_POSTAL_ADDRESS=

# Must include your Vercel app origin(s)
CORS_ORIGIN=https://www.datacaptain.in,https://datacaptain.in,http://localhost:3000
