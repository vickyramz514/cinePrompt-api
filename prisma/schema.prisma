// =============================================================================
// CinePrompt AI - Enterprise-Grade Database Schema
// PostgreSQL + Prisma ORM | Designed for 1M+ users, millions of video jobs
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS - Type safety & query optimization
// =============================================================================

enum UserPlan {
  FREE
  STARTER
  CREATOR
  PRO
  ULTRA
}

enum UserRole {
  USER
  CREATOR
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
  APPLE
}

enum TransactionType {
  VIDEO_GENERATION
  VIDEO_REFUND
  PURCHASE
  SUBSCRIPTION
  BONUS
  ADMIN_ADJUSTMENT
  REFERRAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  REVERSED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  TRIALING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  PAYPAL
  MANUAL
}

enum NotificationType {
  JOB_COMPLETED
  JOB_FAILED
  CREDITS_LOW
  SUBSCRIPTION_RENEWAL
  PAYMENT_RECEIVED
  SYSTEM_ANNOUNCEMENT
}

// =============================================================================
// USER & AUTHENTICATION
// =============================================================================

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  name          String
  password      String?      // Null for OAuth-only users
  provider      String?      // "google" | "email" | null - kept for migration compat
  providerId    String?      // External provider user ID
  avatar        String?
  role          UserRole     @default(USER)
  credits       Int          @default(0) // Cached balance; Wallet is source of truth
  plan          UserPlan     @default(FREE)
  planExpiresAt DateTime?
  emailVerified Boolean      @default(false)
  isActive      Boolean      @default(true)
  lastLoginAt   DateTime?
  referralCode  String?      @unique // For referral/affiliate invites
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  profile           UserProfile?
  refreshTokens     RefreshToken[]
  wallet            Wallet?
  transactions      Transaction[]
  userSubscriptions UserSubscription[]
  payments          Payment[]
  notifications     Notification[]
  adminAuditLogs    AdminAuditLog[]
  supportTickets    SupportTicket[]
  referralsGiven   Referral[]    @relation("Referrer")
  referralsReceived Referral[]   @relation("Referee")
  affiliate         Affiliate?
  growthEvents      GrowthEvent[]

  @@index([email])
  @@index([provider, providerId])
  @@index([role])
  @@index([plan])
  @@index([createdAt])
  @@index([isActive])
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  bio       String?  @db.Text
  company   String?
  website   String?
  timezone  String?  @default("UTC")
  locale    String?  @default("en")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// =============================================================================
// WALLET & CREDIT SYSTEM (Immutable Ledger Pattern)
// =============================================================================

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Int      @default(0) // Current balance (denormalized for performance)
  totalCreditsIn Int      @default(0) // Lifetime credits added
  totalCreditsOut Int     @default(0) // Lifetime credits used
  version        Int      @default(0) // Optimistic locking
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger   CreditLedgerEntry[]

  @@index([userId])
  @@index([balance])
}

model CreditLedgerEntry {
  id          String            @id @default(uuid())
  walletId    String
  amount      Int               // Positive = credit, Negative = debit
  balanceAfter Int              // Snapshot after this entry
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  referenceId String?           // VideoJob id, Payment id, etc.
  referenceType String?         // "video_job" | "payment" | "subscription"
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@index([type])
  @@index([referenceId, referenceType])
  @@index([walletId, createdAt]) // Ledger history query
}

// =============================================================================
// TRANSACTIONS (Legacy compatibility + enhanced)
// =============================================================================

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  amount      Int               // Credits delta
  credits     Int               // Absolute amount
  status      TransactionStatus @default(PENDING)
  type        String            // VIDEO_GENERATION | PURCHASE | etc. - use TransactionType in app
  referenceId String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// =============================================================================
// SUBSCRIPTION & PAYMENTS
// =============================================================================

model SubscriptionPlan {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?  @db.Text
  priceCents       Int      @default(0)
  currency         String   @default("INR")
  credits          Int      @default(0)
  creditsPerMonth  Int?     // For recurring
  billingCycle     String?  // "monthly" | "yearly"
  razorpayPlanId   String?  // Razorpay plan_xxx ID for subscription plans
  features         Json?    // ["1080p", "priority"]
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions UserSubscription[]

  @@index([slug])
  @@index([isActive])
  @@index([razorpayPlanId])
}

model UserSubscription {
  id             String             @id @default(uuid())
  userId         String
  planId         String
  status         SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd Boolean         @default(false)
  cancelledAt   DateTime?
  externalId    String?             // Stripe subscription ID
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model Payment {
  id            String          @id @default(uuid())
  userId        String
  amountCents   Int
  currency      String          @default("INR")
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider
  providerId    String?         // Stripe payment intent ID
  providerData  Json?
  creditsAdded Int?
  subscriptionId String?
  invoiceUrl   String?
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider, providerId])
  @@index([status])
  @@index([createdAt])
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?          @db.Text
  data      Json?            // Deep link, job ID, etc.
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
}

// =============================================================================
// ADMIN AUDIT LOG - Admin action tracking
// =============================================================================

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String   // credit_update | block_user | unblock_user | cancel_job | plan_override
  targetType String  // USER | JOB | PAYMENT | CREDIT
  targetId  String?
  meta      Json?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// =============================================================================
// CUSTOMER SUPPORT
// =============================================================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportMessageSender {
  USER
  ADMIN
}

model SupportTicket {
  id        String               @id @default(uuid())
  userId    String
  subject   String               @db.Text
  status    SupportTicketStatus   @default(OPEN)
  priority  SupportTicketPriority @default(MEDIUM)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SupportMessage {
  id        String              @id @default(uuid())
  ticketId  String
  sender    SupportMessageSender
  message   String              @db.Text
  createdAt DateTime           @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

// =============================================================================
// REFERRAL & AFFILIATE
// =============================================================================

enum ReferralStatus {
  PENDING
  COMPLETED
}

enum AffiliatePayoutStatus {
  REQUESTED
  PAID
}

model Referral {
  id             String        @id @default(uuid())
  referrerId     String
  refereeId      String
  referralCode   String?
  rewardCredits  Int           @default(0)
  rewardCash     Float         @default(0) // INR
  status         ReferralStatus @default(PENDING)
  completedAt    DateTime?
  createdAt      DateTime      @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([refereeId])
  @@index([referrerId])
  @@index([status])
  @@index([createdAt])
}

model Affiliate {
  id             String   @id @default(uuid())
  userId         String   @unique
  referralCode   String   @unique
  commissionRate Float   @default(0.1) // 10%
  totalEarnings  Float   @default(0)
  payoutBalance  Float   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts AffiliatePayout[]

  @@index([referralCode])
}

model AffiliatePayout {
  id         String               @id @default(uuid())
  affiliateId String
  amount     Float
  status     AffiliatePayoutStatus @default(REQUESTED)
  paidAt     DateTime?
  createdAt  DateTime             @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

// =============================================================================
// GROWTH ANALYTICS
// =============================================================================

model GrowthEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String   // signup | login | video_created | payment_done | subscription_started | etc.
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([eventType, createdAt])
}

// =============================================================================
// STOCK & ETF MARKET DATA (US Historical Data API)
// =============================================================================

model Instrument {
  id                  String    @id // firstbridge_id from source
  symbol              String    // composite_ticker (e.g. SPY, AAPL)
  name                String?   @db.Text // composite_name
  type                String    @default("ETF") // ETF | STOCK
  exchangeCode        String?
  exchangeName        String?
  assetClass          String?
  listingCountryCode  String?
  inceptionDate       DateTime?
  isActive            Boolean   @default(true)
  metadata            Json?     // Additional fields from source
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  priceHistory MarketData[]

  @@unique([symbol, type])
  @@index([symbol])
  @@index([type])
  @@index([exchangeCode])
}

model MarketData {
  id           String   @id @default(uuid())
  instrumentId String
  asOfDate     DateTime @db.Date
  open         Float
  high         Float
  low          Float
  close        Float
  volume       BigInt?
  nav          Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, asOfDate])
  @@index([instrumentId])
  @@index([asOfDate])
  @@index([instrumentId, asOfDate])
}

// Encrypted DataCaptain API keys (for /api-keys/me to return full key to returning users)
model ApiKeySecret {
  datacaptainKeyId String   @id @map("apiKeyId") // DataCaptain api_keys.id
  encryptedValue   String   @db.Text
  createdAt        DateTime @default(now())
}
