{
  "name": "cineprompt-ai-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for CinePrompt AI video generation SaaS",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "prisma migrate deploy && node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:seed:plans": "node prisma/seed-subscription-plans.js",
    "db:seed:market": "node scripts/seed-market-data.js",
    "db:seed:etf": "SKIP_MARKET_DATA=1 node scripts/seed-market-data.js",
    "etf:compute-metrics": "node scripts/compute-etf-metrics.js",
    "db:sync:market-prices": "node scripts/sync-market-prices-only.js",
    "db:import:dmd": "node scripts/import-dmd-batches.js",
    "db:cleanup:unused": "node scripts/db-drop-unused-tables.js",
    "db:cleanup:unused:apply": "node scripts/db-drop-unused-tables.js --apply",
    "db:cleanup:video:apply": "node scripts/db-drop-unused-tables.js --apply --video",
    "razorpay:create-plans": "node scripts/create-razorpay-plans.js",
    "razorpay:link-plans": "node scripts/link-razorpay-plans.js",
    "razorpay:link-plans:test": "RAZORPAY_PLAN_MAP_MODE=test node scripts/link-razorpay-plans.js",
    "razorpay:link-plans:live": "RAZORPAY_PLAN_MAP_MODE=live node scripts/link-razorpay-plans.js",
    "razorpay:verify-plans": "node scripts/verify-razorpay-plans.js",
    "smoke:health": "node scripts/smoke-health.mjs",
    "datacaptain:db:migrate": "node src/datacaptain/utils/runMigrations.js",
    "datacaptain:db:seed": "node src/datacaptain/utils/seedApiKey.js",
    "datacaptain:db:seed:snapshot": "node scripts/seed-snapshot-demo-data.js",
    "db:api-key-secrets": "node scripts/create-api-key-secrets-table.js",
    "test": "node --test tests/"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@prisma/client": "^6.4.0",
    "@runwayml/sdk": "^3.14.3",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "prisma": "^6.4.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.6",
    "replicate": "^0.34.0",
    "sequelize": "^6.37.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.0.3",
    "winston": "^3.15.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
