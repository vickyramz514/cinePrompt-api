{
  "name": "cineprompt-ai-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for CinePrompt AI video generation SaaS",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/videoWorker.js",
    "dev:worker": "node --watch src/workers/videoWorker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:seed:plans": "node prisma/seed-subscription-plans.js",
    "db:seed:market": "node scripts/seed-market-data.js",
    "razorpay:create-plans": "node scripts/create-razorpay-plans.js",
    "razorpay:link-plans": "node scripts/link-razorpay-plans.js",
    "test": "node --test tests/"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@prisma/client": "^6.4.0",
    "@runwayml/sdk": "^3.14.3",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.4.0",
    "razorpay": "^2.9.6",
    "replicate": "^0.34.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
