# Server
PORT=4000
NODE_ENV=development

# HTTP rate limits (per IP). Auth routes (/api/auth/*) use AUTH_* separately.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=40

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# After deploy: `npx prisma migrate deploy` (creates ApiKeySecret + widens api_keys.key_prefix for /api-keys/*).

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://:password@host:6379

# JWT (change in production)
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret

# DataCaptain: encrypt stored API key material (required in production; stable across deploys)
API_KEY_ENCRYPTION_SECRET=
# Debug only: include error details in JSON responses (Railway: EXPOSE_API_ERRORS=true)
# EXPOSE_API_ERRORS=false

# Credits: 1 credit = 1 second of video
DEFAULT_CREDITS=30
MAX_RESOLUTION=720p

# Plan limits: maxDuration (sec/video) + videosPerDay
PLAN_FREE_MAX_DURATION=5
PLAN_STARTER_MAX_DURATION=10
PLAN_CREATOR_MAX_DURATION=20
PLAN_PRO_MAX_DURATION=20
PLAN_ULTRA_MAX_DURATION=40
PLAN_LIMIT_FREE=1
PLAN_LIMIT_STARTER=2
PLAN_LIMIT_CREATOR=4
PLAN_LIMIT_PRO=4
PLAN_LIMIT_ULTRA=6

# Abuse prevention (concurrency=1 per user, daily cap per plan)
ABUSE_MAX_REQUESTS_DAY=10
PROMPT_SPAM_WINDOW_MS=60000
PROMPT_SPAM_THRESHOLD=3
PLATFORM_DAILY_VIDEO_LIMIT=10

# API cost (USD per second)
MINIMAX_COST_PER_SECOND=0.04
RUNWAY_COST_PER_SECOND=0.05
REPLICATE_COST_PER_SECOND=0.02

# Minimax Seedance v2 (CCAPI) - primary video provider
MINIMAX_API_KEY=sk-xxx
MINIMAX_BASE_URL=https://api.ccapi.ai
MINIMAX_VIDEO_MODEL=bytedance/seedance-2
MINIMAX_POLL_INTERVAL=7000
MINIMAX_TIMEOUT=600000

# Runway (fallback video provider)
RUNWAY_API_SECRET=key_xxxxxxxx
RUNWAY_MODEL=gen4.5
RUNWAY_TIMEOUT_MS=600000
RUNWAY_POLL_INTERVAL_MS=5000
RUNWAY_MAX_RETRIES=3

# See src/config/loadEnv.js for load order: .env → .env.production (if NODE_ENV=production) → .env.local
# -----------------------------------------------------------------------------
# Razorpay (subscriptions & payments) — BACKEND ONLY. Never expose in Next.js.
# Dashboard: https://dashboard.razorpay.com → API Keys (test: rzp_test_…, live: rzp_live_…)
#
# Test vs live: Plan IDs from Dashboard → Subscriptions → Plans are MODE-SPECIFIC.
# Use rzp_test_* keys ONLY with plan_… IDs copied while “Test mode” is ON.
# Using a live plan_id with test keys (or the reverse) → “invalid or could not be found”.
#
# Webhook: Razorpay → Webhooks → URL = https://YOUR-API-HOST/api/payment/webhook
#         (same path as in server; raw body required for signature verification)
#         Set “Secret” in Razorpay and paste the same value as RAZORPAY_WEBHOOK_SECRET below.
#
# Link Razorpay plan IDs to DB:
# Preferred: edit scripts/razorpay-plans.test.json and scripts/razorpay-plans.live.json
# then run:
#   npm run razorpay:link-plans:test
#   npm run razorpay:link-plans:live
#
# Optional fallback (legacy env vars):
#   RAZORPAY_PLAN_STARTER=plan_xxx RAZORPAY_PLAN_CREATOR=plan_xxx RAZORPAY_PLAN_ULTRA=plan_xxx npm run razorpay:link-plans
#
# Optional: explicit mode (test|live). Must match RAZORPAY_KEY_ID (rzp_test_* vs rzp_live_*). Mismatch logs a warning.
# RAZORPAY_MODE=test
# Optional mode override for link script (otherwise inferred from RAZORPAY_KEY_ID): test|live
# RAZORPAY_PLAN_MAP_MODE=test
#
# Deploy: NODE_ENV=production does NOT switch Razorpay to live. Test keys on a public URL still = sandbox only.
#         For real money: use rzp_live_* here, create/link LIVE plan_* in DB, add LIVE webhook URL + secret.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_or_same_as_dashboard_webhook_secret

# Replicate
REPLICATE_API_TOKEN=

# Storage (S3/R2)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=cineprompt-videos
STORAGE_ENDPOINT=
STORAGE_REGION=auto
SIGNED_URL_EXPIRY=3600

# CDN (optional - public base URL for video delivery)
CDN_BASE_URL=

# CORS (comma-separated for multiple: production, preview, localhost)
CORS_ORIGIN=http://localhost:3000

# Google OAuth (must match frontend Google client for token verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
