# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cineprompt?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (change in production)
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret

# Credits & Video Limits (1 credit = 1 second)
DEFAULT_CREDITS=30
CREDIT_COST_PER_VIDEO=5
MAX_VIDEO_SECONDS=5
MAX_RESOLUTION=720p

# Plan limits (videos/day): FREE, STARTER, CREATOR, PRO, ULTRA
PLAN_LIMIT_FREE=1
PLAN_LIMIT_STARTER=2
PLAN_LIMIT_CREATOR=4
PLAN_LIMIT_ULTRA=6

# Abuse prevention
ABUSE_MAX_REQUESTS_DAY=10
PROMPT_SPAM_WINDOW_MS=60000
PROMPT_SPAM_THRESHOLD=3

# API cost (USD per second)
RUNWAY_COST_PER_SECOND=0.05
REPLICATE_COST_PER_SECOND=0.02

# Runway (primary video provider)
RUNWAY_API_SECRET=
# Or: RUNWAYML_API_SECRET=  (SDK default)
RUNWAY_MODEL=gen4.5
RUNWAY_TIMEOUT_MS=600000
RUNWAY_POLL_INTERVAL_MS=5000
RUNWAY_MAX_RETRIES=3

# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Replicate
REPLICATE_API_TOKEN=

# Storage (S3/R2)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=cineprompt-videos
STORAGE_ENDPOINT=
STORAGE_REGION=auto
SIGNED_URL_EXPIRY=3600

# CDN (optional - public base URL for video delivery)
CDN_BASE_URL=

# CORS
CORS_ORIGIN=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
